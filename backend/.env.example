# ====================================
# 🔒 3SAY PLATFORM - BACKEND ENV CONFIG
# ====================================
# Last Updated: 2025-11-01
# Security Level: PRODUCTION READY

# ====================================
# ENVIRONMENT CONFIGURATION
# ====================================
NODE_ENV=development  # Options: development, production
PORT=5001            # Backend API port (changed from 5000 to avoid conflicts)

# ====================================
# 🔥 FIREBASE CONFIGURATION
# ====================================
# Firebase Admin SDK - Required for authentication
FIREBASE_PROJECT_ID=zaraa-8d3a9
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zaraa-8d3a9.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Database URL
DATABASE_URL=https://zaraa-8d3a9-default-rtdb.asia-southeast1.firebasedatabase.app

# ====================================
# 🔐 SECURITY CONFIGURATION
# ====================================
# JWT Secret - CRITICAL: Use strong random string (32+ characters)
# Generate: openssl rand -base64 32
# Generate (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production-use-openssl-rand-base64-32

# Session Secret - CRITICAL: Change in production
# Generate same way as JWT_SECRET
SESSION_SECRET=your-session-secret-here-change-this-use-openssl-rand-base64-32

# ====================================
# 🌐 CORS CONFIGURATION
# ====================================
# SECURITY: Only allow specific origins (NO wildcards in production)
# Development: localhost
# Production: your actual domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ====================================
# 🛡️ RATE LIMITING & SECURITY
# ====================================
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes (in milliseconds)
RATE_LIMIT_MAX_REQUESTS=100     # Max requests per window per IP

# Strict rate limiting for sensitive endpoints (auth, payment)
STRICT_RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
STRICT_RATE_LIMIT_MAX_REQUESTS=10    # Max requests per window

# Session configuration
SESSION_MAX_AGE=86400000        # 24 hours in milliseconds (1 day)

# Cookie security (automatically configured based on NODE_ENV)
# Production: httpOnly=true, secure=true, sameSite=strict
# Development: httpOnly=true, secure=false, sameSite=strict

# ====================================
# 📧 EMAIL CONFIGURATION (Optional)
# ====================================
# SMTP settings for email verification & notifications
# EMAIL_FROM=noreply@3say.mn
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password

# ====================================
# 📊 MONITORING & LOGGING (Optional)
# ====================================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ====================================
# 💳 PAYMENT GATEWAY CONFIGURATION
# ====================================

# QPay (Mongolia) - https://developer.qpay.mn/
QPAY_API_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=your-qpay-merchant-username
QPAY_PASSWORD=your-qpay-merchant-password
QPAY_INVOICE_CODE=YOUR_INVOICE_CODE

# SocialPay / Golomt Bank (Mongolia)
SOCIALPAY_API_URL=https://ecommerce.golomtbank.com/api
SOCIALPAY_MERCHANT_ID=your-golomt-merchant-id
SOCIALPAY_API_KEY=your-golomt-api-key
SOCIALPAY_CALLBACK_URL=http://localhost:5001/api/payments/socialpay/callback

# Khan Bank (Mongolia) - Optional
# KHAN_BANK_API_URL=https://api.khanbank.com
# KHAN_BANK_MERCHANT_ID=your-khan-merchant-id
# KHAN_BANK_API_KEY=your-khan-api-key
# KHAN_BANK_CALLBACK_URL=http://localhost:5001/api/payments/khanbank/callback

# ====================================
# 🌍 API CONFIGURATION
# ====================================
# API Base URL - Used for webhooks and callbacks
# Development: http://localhost:5001
# Production: https://api.yourdomain.com
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# ====================================
# 🎲 SPIN WHEEL & REWARDS
# ====================================
# Default spins per day for users
DEFAULT_DAILY_SPINS=3

# Reward probabilities (sum should be 100)
# REWARD_PROBABILITY_COMMON=50
# REWARD_PROBABILITY_RARE=30
# REWARD_PROBABILITY_EPIC=15
# REWARD_PROBABILITY_LEGENDARY=5

# ====================================
# 📦 FILE UPLOAD CONFIGURATION
# ====================================
# Maximum file upload size (in bytes)
MAX_FILE_SIZE=10485760  # 10MB

# Allowed image types
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif

# ====================================
# 🔧 ADDITIONAL FEATURES
# ====================================
# Enable/disable features
ENABLE_EMAIL_VERIFICATION=false
ENABLE_SMS_VERIFICATION=true
ENABLE_ADMIN_DASHBOARD=true
ENABLE_PAYMENT_GATEWAY=true
ENABLE_SPIN_WHEEL=true

# ====================================
# 📱 SMS VERIFICATION CONFIGURATION
# ====================================
# SMS Provider Options: twilio, skytel, unitel, aws, firebase
# Leave empty or set to 'none' for development mode (console only)
SMS_PROVIDER=none  # Set to 'skytel', 'unitel', or 'twilio' in production

# TWILIO (International - Works in Mongolia)
# Get credentials: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# SKYTEL SMS GATEWAY (Mongolia Local Provider)
# Contact: https://www.skytel.mn/business/sms-gateway
# SKYTEL_USERNAME=your_username
# SKYTEL_PASSWORD=your_password
# SKYTEL_SENDER_ID=3SAY

# UNITEL SMS API (Mongolia)
# Contact: Unitel business support
# UNITEL_API_KEY=your_api_key
# UNITEL_SENDER_ID=3SAY

# AWS SNS (Amazon Simple Notification Service)
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Generic SMS Gateway (Alternative)
# SMS_API_URL=https://sms-gateway.example.com/api/send
# SMS_API_KEY=your_api_key
# SMS_SENDER_ID=3SAY

# SMS Configuration
SMS_CODE_LENGTH=6           # Verification code length (6 digits)
SMS_CODE_EXPIRY=300000      # Code expiry time in milliseconds (5 minutes)
SMS_RATE_LIMIT=60000        # Minimum time between SMS requests (1 minute)
SMS_MAX_ATTEMPTS=3          # Maximum verification attempts per code

# ====================================
# 🚀 DEPLOYMENT NOTES
# ====================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all required values marked with "your-"
# 3. Generate secure secrets using: openssl rand -base64 32
# 4. Never commit .env file to git (already in .gitignore)
# 5. In production:
#    - Set NODE_ENV=production
#    - Use strong JWT_SECRET and SESSION_SECRET
#    - Set ALLOWED_ORIGINS to your actual domain(s)
#    - Enable HTTPS (secure cookies)
#    - Set up proper payment gateway credentials
# 6. Test all payment webhooks with ngrok or similar tool

# ====================================
# 📋 CHECKLIST BEFORE DEPLOYMENT
# ====================================
# [ ] NODE_ENV set to production
# [ ] JWT_SECRET changed to secure random string (32+ chars)
# [ ] SESSION_SECRET changed to secure random string (32+ chars)
# [ ] ALLOWED_ORIGINS set to production domain(s)
# [ ] Firebase credentials configured correctly
# [ ] Payment gateway credentials verified
# [ ] API_URL set to production domain
# [ ] FRONTEND_URL set to production domain
# [ ] Rate limiting configured appropriately
# [ ] HTTPS enabled (secure cookies)
# [ ] Database backups configured
# [ ] Monitoring/logging set up (Sentry, etc.)
# [ ] Environment variables secured in hosting platform